    {
      "name": "streams_2",
      "extra": {
        "data_path": "staged",
        "copy_stream_pool_size": 2
      }
    },
    {
      "name": "streams_4",
      "extra": {
        "data_path": "staged",
        "copy_stream_pool_size": 4
      }
    },
    {
      "name": "streams_8",
      "extra": {
        "data_path": "staged",
        "copy_stream_pool_size": 8
      }
    },
    {
      "name": "staging_3gb",
      "extra": {
        "staging_pool_gb": 3
      }
    },
    {
      "name": "staging_6gb",
      "extra": {
        "staging_pool_gb": 6
