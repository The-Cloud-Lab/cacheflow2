{
  "name": "staging",
  "description": "Sensitivity to staging resources (copy streams matter on the staged path).",
  "model": "Qwen/Qwen3-4B",
  "server_host": "10.0.1.2",
  "port": 8100,
  "vllm_args": [
    "--max-model-len",
    "32000",
    "--gpu-memory-utilization",
    "0.3"
